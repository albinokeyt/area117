# ==========================================
# EFI DATA OIL - Variables de Entorno
# ==========================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# PostgreSQL es obligatorio. En Easypanel conserva la URL de la base existente.
DATABASE_URL="postgresql://usuario:contraseña@postgres:5432/efi_data_oil"

# Telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1

# Las sesiones se guardan en PostgreSQL con tokens aleatorios.

# Administrador de emergencia independiente de los usuarios registrados.
# Opcional: se habilita solo al configurar ambas variables y redesplegar.
# El usuario puede ser un nombre o un correo. No usar prefijo NEXT_PUBLIC_.
ADMIN_USERNAME=
ADMIN_PASSWORD=
