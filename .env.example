# ==========================================
# EFI DATA OIL - Variables de Entorno
# ==========================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Base de datos SQLite por defecto (persistente)
DATABASE_URL="file:./dev.db"

# Si usas PostgreSQL en Easypanel, descomenta y usa el formato:
# DATABASE_URL="postgresql://usuario:contraseña@postgres:5432/efi_data_oil?schema=public"

# Telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1

# Clave secreta para tokens / sesiones
SECRET_KEY=efi-data-oil-secure-token-2026
